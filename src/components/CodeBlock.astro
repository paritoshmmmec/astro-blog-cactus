---
import { Prism } from "@astrojs/prism";

const { language, content } = Astro.props;
---

{
  language === "math" ? (
    /*
      Math fences (```math) are shielded from Markdoc's inline parser, which
      mangles _ subscripts in LaTeX. We emit the source (unescaping Markdoc's
      mandatory \_ escapes) into a hidden node; ContentLayout's boot script
      renders it with katex.render as a display equation. Nothing visible
      here, so there is no flash of raw LaTeX.
    */
    <div class="math-source" style="display:none">
      {content.replace(/\\_/g, "_")}
    </div>
  ) : (
    <Prism lang={language} code={content} />
  )
}

<style is:global>
  /**
   * Coldark Theme for Prism.js — dual variant.
   * Light mode uses Coldark "Cold", dark mode uses Coldark "Dark".
   * Both palettes from https://github.com/ArmandPhilippot/coldark-prism (MIT)
   * by Armand Philippot <contact@armandphilippot.com>.
   * All colors are tokenized below so both palettes live side by side and
   * switch automatically with the site's .dark class (see global.css).
   */

  /* Coldark Cold — light mode palette */
  html.theme-sleek {
    --code-text: rgb(17 27 39);
    --code-bg: rgb(227 234 242);
    --code-select: rgb(141 161 185);
    --code-comment: rgb(60 82 109);
    --code-punct: rgb(17 27 39);
    --code-tag: rgb(0 109 109);
    --code-attr: rgb(117 95 0);
    --code-entity: rgb(0 90 142);
    --code-string: rgb(17 107 0);
    --code-builtin: rgb(175 0 175);
    --code-function: rgb(124 0 170);
    --code-keyword: rgb(160 73 0);
    --code-deleted: rgb(194 47 46);
    --code-toolbar-text: rgb(227 234 242);
    --code-toolbar-bg: rgb(0 90 142);
    --code-toolbar-bg-hover: rgb(0 90 142 / 0.85);
    --code-toolbar-muted: rgb(60 82 109);
    --code-highlight-a: rgb(141 161 185 / 0.18);
    --code-highlight-b: rgb(141 161 185 / 0.145);
    --code-highlight-label-bg: rgb(60 82 109);
    --code-highlight-label-text: rgb(227 234 242);
    --code-highlight-shadow: rgb(141 161 185);
    --code-linkable-hover: rgb(60 82 109 / 0.12);
    --code-linenum-border: rgb(141 161 185 / 0.48);
    --code-linenum-bg: rgb(208 218 231 / 0.48);
    --code-linenum-text: rgb(60 82 109 / 0.85);
    --code-diff-del: rgb(194 47 46 / 0.12);
    --code-diff-ins: rgb(17 107 0 / 0.12);
  }

  /* Coldark Dark — dark mode palette */
  html.theme-sleek.dark {
    --code-text: rgb(227 234 242);
    --code-bg: rgb(17 27 39);
    --code-select: rgb(60 82 109);
    --code-comment: rgb(141 161 185);
    --code-punct: rgb(227 234 242);
    --code-tag: rgb(102 204 204);
    --code-attr: rgb(230 211 122);
    --code-entity: rgb(108 184 230);
    --code-string: rgb(145 208 118);
    --code-builtin: rgb(244 173 244);
    --code-function: rgb(198 153 227);
    --code-keyword: rgb(233 174 126);
    --code-deleted: rgb(205 102 96);
    --code-toolbar-text: rgb(17 27 39);
    --code-toolbar-bg: rgb(108 184 230);
    --code-toolbar-bg-hover: rgb(108 184 230 / 0.85);
    --code-toolbar-muted: rgb(141 161 185);
    --code-highlight-a: rgb(60 82 109 / 0.37);
    --code-highlight-b: rgb(60 82 109 / 0.33);
    --code-highlight-label-bg: rgb(141 161 185);
    --code-highlight-label-text: rgb(17 27 39);
    --code-highlight-shadow: rgb(60 82 109);
    --code-linkable-hover: rgb(141 161 185 / 0.094);
    --code-linenum-border: rgb(11 18 27);
    --code-linenum-bg: rgb(11 18 27 / 0.48);
    --code-linenum-text: rgb(141 161 185 / 0.85);
    --code-diff-del: rgb(205 102 96 / 0.12);
    --code-diff-ins: rgb(145 208 118 / 0.12);
  }

  code[class*="language-"],
  pre[class*="language-"] {
    color: var(--code-text);
    background: none;
    font-family: theme("fontFamily.mono");
    text-align: left;
    white-space: pre;
    word-spacing: normal;
    word-break: normal;
    word-wrap: normal;
    line-height: 1.5;
    -moz-tab-size: 4;
    -o-tab-size: 4;
    tab-size: 4;
    -webkit-hyphens: none;
    -moz-hyphens: none;
    -ms-hyphens: none;
    hyphens: none;
  }

  pre[class*="language-"]::-moz-selection,
  pre[class*="language-"] ::-moz-selection,
  code[class*="language-"]::-moz-selection,
  code[class*="language-"] ::-moz-selection {
    background: var(--code-select);
  }

  pre[class*="language-"]::selection,
  pre[class*="language-"] ::selection,
  code[class*="language-"]::selection,
  code[class*="language-"] ::selection {
    background: var(--code-select);
  }

  /* Code blocks */
  pre[class*="language-"] {
    padding: 1em;
    margin: 0.5em 0;
    overflow: auto;
  }

  :not(pre) > code[class*="language-"],
  pre[class*="language-"] {
    background: var(--code-bg);
  }

  /* Inline code */
  :not(pre) > code[class*="language-"] {
    padding: 0.1em 0.3em;
    border-radius: 0.3em;
    white-space: normal;
  }

  .token.comment,
  .token.prolog,
  .token.doctype,
  .token.cdata {
    color: var(--code-comment);
  }

  .token.punctuation {
    color: var(--code-punct);
  }

  .token.delimiter.important,
  .token.selector .parent,
  .token.tag,
  .token.tag .token.punctuation {
    color: var(--code-tag);
  }

  .token.attr-name,
  .token.boolean,
  .token.boolean.important,
  .token.number,
  .token.constant,
  .token.selector .token.attribute {
    color: var(--code-attr);
  }

  .token.class-name,
  .token.key,
  .token.parameter,
  .token.property,
  .token.property-access,
  .token.variable {
    color: var(--code-entity);
  }

  .token.attr-value,
  .token.inserted,
  .token.color,
  .token.selector .token.value,
  .token.string,
  .token.string .token.url-link {
    color: var(--code-string);
  }

  .token.builtin,
  .token.keyword-array,
  .token.package,
  .token.regex {
    color: var(--code-builtin);
  }

  .token.function,
  .token.selector .token.class,
  .token.selector .token.id {
    color: var(--code-function);
  }

  .token.atrule .token.rule,
  .token.combinator,
  .token.keyword,
  .token.operator,
  .token.pseudo-class,
  .token.pseudo-element,
  .token.selector,
  .token.unit {
    color: var(--code-keyword);
  }

  .token.deleted,
  .token.important {
    color: var(--code-deleted);
  }

  .token.keyword-this,
  .token.this {
    color: var(--code-entity);
  }

  .token.important,
  .token.keyword-this,
  .token.this,
  .token.bold {
    font-weight: bold;
  }

  .token.delimiter.important {
    font-weight: inherit;
  }

  .token.italic {
    font-style: italic;
  }

  .token.entity {
    cursor: help;
  }

  .language-markdown .token.title,
  .language-markdown .token.title .token.punctuation {
    color: var(--code-entity);
    font-weight: bold;
  }

  .language-markdown .token.blockquote.punctuation {
    color: var(--code-builtin);
  }

  .language-markdown .token.code {
    color: var(--code-tag);
  }

  .language-markdown .token.hr.punctuation {
    color: var(--code-entity);
  }

  .language-markdown .token.url .token.content {
    color: var(--code-string);
  }

  .language-markdown .token.url-link {
    color: var(--code-attr);
  }

  .language-markdown .token.list.punctuation {
    color: var(--code-builtin);
  }

  .language-markdown .token.table-header {
    color: var(--code-text);
  }

  .language-json .token.operator {
    color: var(--code-text);
  }

  .language-scss .token.variable {
    color: var(--code-tag);
  }

  /* overrides color-values for the Show Invisibles plugin
 * https://prismjs.com/plugins/show-invisibles/
 */
  .token.token.tab:not(:empty):before,
  .token.token.cr:before,
  .token.token.lf:before,
  .token.token.space:before {
    color: var(--code-comment);
  }

  /* overrides color-values for the Toolbar plugin
 * https://prismjs.com/plugins/toolbar/
 */
  div.code-toolbar > .toolbar.toolbar > .toolbar-item > a,
  div.code-toolbar > .toolbar.toolbar > .toolbar-item > button {
    color: var(--code-toolbar-text);
    background: var(--code-toolbar-bg);
  }

  div.code-toolbar > .toolbar.toolbar > .toolbar-item > a:hover,
  div.code-toolbar > .toolbar.toolbar > .toolbar-item > a:focus,
  div.code-toolbar > .toolbar.toolbar > .toolbar-item > button:hover,
  div.code-toolbar > .toolbar.toolbar > .toolbar-item > button:focus {
    color: var(--code-toolbar-text);
    background: var(--code-toolbar-bg-hover);
    text-decoration: none;
  }

  div.code-toolbar > .toolbar.toolbar > .toolbar-item > span,
  div.code-toolbar > .toolbar.toolbar > .toolbar-item > span:hover,
  div.code-toolbar > .toolbar.toolbar > .toolbar-item > span:focus {
    color: var(--code-toolbar-text);
    background: var(--code-toolbar-muted);
  }

  /* overrides color-values for the Line Highlight plugin
 * http://prismjs.com/plugins/line-highlight/
 */
  .line-highlight.line-highlight {
    background: var(--code-highlight-a);
    background: linear-gradient(to right, var(--code-highlight-a) 70%, var(--code-highlight-b));
  }

  .line-highlight.line-highlight:before,
  .line-highlight.line-highlight[data-end]:after {
    background-color: var(--code-highlight-label-bg);
    color: var(--code-highlight-label-text);
    box-shadow: 0 1px var(--code-highlight-shadow);
  }

  pre[id].linkable-line-numbers.linkable-line-numbers
    span.line-numbers-rows
    > span:hover:before {
    background-color: var(--code-linkable-hover);
  }

  /* overrides color-values for the Line Numbers plugin
 * http://prismjs.com/plugins/line-numbers/
 */
  .line-numbers.line-numbers .line-numbers-rows {
    border-right: 1px solid var(--code-linenum-border);
    background: var(--code-linenum-bg);
  }

  .line-numbers .line-numbers-rows > span:before {
    color: var(--code-linenum-text);
  }

  /* overrides color-values for the Match Braces plugin
 * https://prismjs.com/plugins/match-braces/
 */
  .rainbow-braces .token.token.punctuation.brace-level-1,
  .rainbow-braces .token.token.punctuation.brace-level-5,
  .rainbow-braces .token.token.punctuation.brace-level-9 {
    color: var(--code-attr);
  }

  .rainbow-braces .token.token.punctuation.brace-level-2,
  .rainbow-braces .token.token.punctuation.brace-level-6,
  .rainbow-braces .token.token.punctuation.brace-level-10 {
    color: var(--code-builtin);
  }

  .rainbow-braces .token.token.punctuation.brace-level-3,
  .rainbow-braces .token.token.punctuation.brace-level-7,
  .rainbow-braces .token.token.punctuation.brace-level-11 {
    color: var(--code-entity);
  }

  .rainbow-braces .token.token.punctuation.brace-level-4,
  .rainbow-braces .token.token.punctuation.brace-level-8,
  .rainbow-braces .token.token.punctuation.brace-level-12 {
    color: var(--code-function);
  }

  /* overrides color-values for the Diff Highlight plugin
 * https://prismjs.com/plugins/diff-highlight/
 */
  pre.diff-highlight > code .token.token.deleted:not(.prefix),
  pre > code.diff-highlight .token.token.deleted:not(.prefix) {
    background-color: var(--code-diff-del);
  }

  pre.diff-highlight > code .token.token.inserted:not(.prefix),
  pre > code.diff-highlight .token.token.inserted:not(.prefix) {
    background-color: var(--code-diff-ins);
  }

  /* overrides color-values for the Command Line plugin
 * https://prismjs.com/plugins/command-line/
 */
  .command-line .command-line-prompt {
    border-right: 1px solid var(--code-linenum-border);
  }

  .command-line .command-line-prompt > span:before {
    color: var(--code-linenum-text);
  }
</style>
