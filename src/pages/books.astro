---
import { readAll } from "../lib/markdoc/read";
import { blog } from "../lib/markdoc/frontmatter.schema";
import PageLayout from "../layouts/PageLayout.astro";
import PageMeta from "../components/PageMeta.astro";
import { SITE_TITLE } from "../config";

const books = await readAll({
  directory: "books",
  frontmatterSchema: blog,
});

const sortedBooks = books
  .filter((p) => p.frontmatter.draft !== true)
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).valueOf() -
      new Date(a.frontmatter.date).valueOf()
  );
---

<PageLayout>
  <PageMeta title={`Books | ${SITE_TITLE}`} slot="meta" />
  <section slot="main">
    <h1 class="text-4xl mb-8">Books</h1>
    <ul class="unset book-list">
      {
        sortedBooks.map((book) => {
          const formattedDate = new Date(
            book.frontmatter.date
          ).toLocaleDateString("en-us", {
            year: "numeric",
            month: "short",
            day: "numeric",
          });
          return (
            <li>
              <div class="book-body">
                {book.frontmatter.external ? (
                  <a
                    href={book.frontmatter.url}
                    target="_blank"
                    class="unset book-link"
                  >
                    <span>{book.frontmatter.title}</span>
                    <span class="external" aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <a href={`/books/${book.slug}`} class="unset book-link">
                    {book.frontmatter.title}
                  </a>
                )}
                {book.frontmatter.external !== true &&
                  book.frontmatter.description && (
                    <p class="book-desc">
                      {book.frontmatter.description}
                    </p>
                  )}
              </div>
              <time datetime={book.frontmatter.date.toISOString()}>
                {formattedDate}
              </time>
            </li>
          );
        })
      }
    </ul>
  </section>
</PageLayout>

<style>
  .book-list {
    margin: 0;
    padding: 0;
  }

  .book-list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    border-top: 1px solid rgb(var(--color-border-muted));
    padding: 0.85rem 0;
    margin: 0;
  }

  .book-body {
    min-width: 0;
  }

  .book-link {
    background-image: none !important;
  }

  .book-link:hover {
    color: rgb(var(--color-text-link));
  }

  .book-desc {
    color: rgb(var(--color-text-muted));
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0.25rem 0 0;
  }

  .external {
    margin-left: 0.25rem;
    color: rgb(var(--color-text-muted));
  }

  time {
    color: rgb(var(--color-text-muted));
    white-space: nowrap;
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .book-list li {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.15rem;
    }
  }
</style>
