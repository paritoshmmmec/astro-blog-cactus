---
/* 
  This layout is used in pages that render markdoc content
  - pages/blog/[slug].astro
*/

// Import the global.css file here so that it is included on
import "../styles/global.css";

import Header from "../components/Header.astro";
import Favicon from "./Favicon.astro";
import ThemeScript from "./ThemeScript.astro";
import Fonts from "./Fonts.astro";

export interface Props {
  title: string;
  date: Date;
  readingTime?: string;
  tags?: string[];
}

const { title, date, readingTime, tags } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString("en-us", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<!DOCTYPE html>
<html class="theme-sleek" lang="en">
  <head>
    <!-- Global Metadata -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content="Blogster" />
    <Favicon />
    <ThemeScript />
    <Fonts />
    <link rel="stylesheet" href="/katex/katex.min.css" />
    <style is:global>
      /* wide equations scroll instead of overflowing on small screens */
      .blog-post .katex-display {
        overflow-x: auto;
        overflow-y: hidden;
        padding: 0.25rem 0;
      }
    </style>
    <script src="/katex/katex.min.js" is:inline defer></script>
    <script src="/katex/auto-render.min.js" is:inline defer></script>
    <slot name="meta" />
  </head>

  <body>
    <a
      class="unset absolute z-20 left-[50%] -top-[100rem] translate-x-[-50%] bg-white text-black px-8 py-2 focus:top-4"
      href="#main"
    >
      Skip to content
    </a>

    <div class="page-shell">
      <Header />
      <main id="main" class="page-main">
        <article class="blog-post prose max-w-none prose-sleek">
          <header class="post-header">
            <h1 class="m-0 mb-4 text-title">{title}</h1>
            <div class="post-meta text-meta">
              <time>{formattedDate}</time>
              {readingTime && <span class="meta-dot" aria-hidden="true">·</span>}
              {readingTime && <span>{readingTime}</span>}
              {tags && tags.length > 0 && <span class="meta-dot" aria-hidden="true">·</span>}
              {tags && tags.length > 0 && (
                <span class="tag-list">
                  {tags.map((tag) => (
                    <span class="tag-pill">{tag}</span>
                  ))}
                </span>
              )}
            </div>
          </header>
          <div class="prose-measure">
            <slot name="content" />
            <slot name="post-nav" />
          </div>
        </article>
      </main>
    </div>

    <script is:inline>
      (function () {
        var rendered = false;
        function renderMath() {
          if (rendered) return;
          rendered = true;
          if (!window.katex) return;
          var container = document.querySelector(".blog-post");
          if (!container) return;
          // 1. ```math fences (emitted by CodeBlock.astro as hidden .math-source
          //    divs with \_ already unescaped) -> display equations.
          container.querySelectorAll(".math-source").forEach(function (el) {
            var tex = el.textContent;
            try {
              katex.render(tex, el, { displayMode: true, throwOnError: false });
              el.style.display = "block";
            } catch (e) {
              el.style.display = "block";
              el.textContent = tex;
            }
          });
          // 2. Inline $...$ in prose — hand-rolled so we can unescape
          //    Markdoc's \_ before KaTeX sees it. Prism/code nodes are skipped.
          var walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT, {
            acceptNode: function (node) {
              var p = node.parentNode;
              if (!p || /^(PRE|CODE|SCRIPT|STYLE|TEXTAREA)$/.test(p.nodeName)) {
                return NodeFilter.FILTER_REJECT;
              }
              return node.nodeValue.indexOf("$") !== -1
                ? NodeFilter.FILTER_ACCEPT
                : NodeFilter.FILTER_SKIP;
            },
          });
          var textNodes = [];
          while (walker.nextNode()) textNodes.push(walker.currentNode);
          textNodes.forEach(function (node) {
            var text = node.nodeValue;
            var frag = document.createDocumentFragment();
            var last = 0;
            var re = /\$([^$\n]+?)\$/g;
            var m;
            var found = false;
            while ((m = re.exec(text)) !== null) {
              found = true;
              frag.appendChild(document.createTextNode(text.slice(last, m.index)));
              var span = document.createElement("span");
              try {
                katex.render(m[1].replace(/\\\\_/g, "_"), span, {
                  displayMode: false,
                  throwOnError: false,
                });
              } catch (e) {
                span.textContent = m[0];
              }
              frag.appendChild(span);
              last = m.index + m[0].length;
            }
            if (found) {
              frag.appendChild(document.createTextNode(text.slice(last)));
              node.parentNode.replaceChild(frag, node);
            }
          });
          // 3. Legacy delimiters, in case future posts use \( \) or \[ \].
          if (window.renderMathInElement) {
            renderMathInElement(container, {
              delimiters: [
                { left: "$$", right: "$$", display: true },
                { left: "\\(", right: "\\)", display: false },
                { left: "\\[", right: "\\]", display: true },
              ],
              ignoredTags: ["script", "noscript", "style", "textarea", "pre", "code"],
              ignoredClasses: ["math-source"],
              throwOnError: false,
            });
          }
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", renderMath);
        } else {
          renderMath();
        }
      })();
    </script>
  </body>
</html>

<style>
  .post-header {
    margin-bottom: 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgb(var(--color-border-muted));
  }

  .post-header h1 {
    line-height: 1.15;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    color: rgb(var(--color-text-muted));
  }

  .post-meta time {
    font-style: italic;
  }

  .meta-dot {
    opacity: 0.6;
  }

  .tag-list {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .prose-measure {
    max-width: 66ch;
  }

  .tag-pill {
    display: inline-block;
    font-size: 0.78rem;
    font-style: normal;
    padding: 0.1rem 0.55rem;
    border: 1px solid rgb(var(--color-border-muted));
    border-radius: 999px;
    background-color: rgb(var(--color-bg-code));
  }
</style>
